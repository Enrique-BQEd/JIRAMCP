# URL raíz de Jira Server/Data Center, sin /rest/api/2
JIRA_BASE_URL=https://jira.example.com

# Credenciales de la persona que ejecuta el MCP.
# No guardes este archivo como .env en git.
JIRA_USERNAME=tu-usuario
JIRA_PASSWORD=tu-contraseña-o-credencial

JIRA_TIMEOUT_MS=15000
PROJECT_CONFIG_PATH=.jira-mcp-projects.json

# Opcional: limita los proyectos que el MCP puede configurar.
# ALLOWED_PROJECTS=OLA,OTRO

# Solo para pruebas locales sin TLS. No usar en producción.
# JIRA_ALLOW_HTTP=true
