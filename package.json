    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "jszip": "^3.10.2",
    "tsx": "^4.19.0",
    "typescript": "^5.8.3",
    "vitest": "^3.1.3"
  }
}
